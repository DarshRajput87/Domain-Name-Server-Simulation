{
  "name": "dns-resolution-observatory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n dns,web -c magenta,cyan \"npm:dns-server:dev\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dns-server": "tsx server/main.ts",
    "dns-server:dev": "tsx watch server/main.ts",
    "build": "next build && npm run build:server && npm run build:assets",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/dns-server.mjs",
    "build:assets": "node -e \"const fs=require('fs');fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\"",
    "start": "concurrently -k -n dns,web -c magenta,cyan \"npm:dns-server\" \"npm:start:web\"",
    "start:web": "next start",
    "start:prod": "node scripts/start-prod.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/resolver.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
