# Copy to .env and adjust. All values are optional; these are the defaults.

# Next.js HTTP server
PORT=3000
# Bind address for the web server (Docker image sets 0.0.0.0)
# HOSTNAME=0.0.0.0

# Internal DNS TCP simulation service. Keep it on loopback; it is not meant to be public.
DNS_TCP_HOST=127.0.0.1
DNS_TCP_PORT=7053

# Max simultaneous lookups. All visitors share one gateway connection, so this is a site-wide limit.
DNS_MAX_INFLIGHT=64

# Domain -> address registry CSV and the max number of generated names it will store.
DNS_SIM_CSV=data/sim-domains.csv
DNS_SIM_MAX_DOMAINS=20000
